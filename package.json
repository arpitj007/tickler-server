{
  "name": "tickler-server",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:node": "NODE_OPTIONS=--experimental-sqlite TICKLER_DATA_DIR=./data tsx watch src/node.ts",
    "build:node": "esbuild src/node.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/node.js",
    "start": "node dist/node.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "seed": "NODE_OPTIONS=--experimental-sqlite tsx scripts/seed.ts",
    "deploy": "wrangler deploy",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "reset-admin": "NODE_OPTIONS=--experimental-sqlite tsx src/node.ts reset-admin",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "provider": "tsx scripts/provider.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@simplewebauthn/server": "^14.0.3",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.16",
    "jose": "^6.2.15",
    "node-cron": "^4.6.0",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/node-cron": "^3.0.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "SQLite database for your entries, projects and money data."
      },
      "TICKLER_SECRET": {
        "description": "A long random secret (for example from `openssl rand -base64 32`). It encrypts provider keys, and you enter it once on **/setup** to claim the server. Keep a copy."
      },
      "TICKLER_SERVER_NAME": {
        "description": "A name for this server, shown in the app (for example **Personal** or **Work**)."
      },
      "TICKLER_CURRENCY": {
        "description": "Your currency for money totals, an ISO code like `USD` or `EUR`."
      }
    }
  }
}
